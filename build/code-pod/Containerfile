# syntax=docker/dockerfile:1.25
FROM docker.io/library/archlinux:base-devel AS aur-build

RUN pacman -Syu --noconfirm git \
 && useradd -m -G wheel builder \
 && echo 'builder ALL=(ALL) NOPASSWD: /usr/bin/pacman' > /etc/sudoers.d/builder

USER builder
WORKDIR /home/builder

RUN git clone --depth=1 https://aur.archlinux.org/yay-bin.git

WORKDIR /home/builder/yay-bin
RUN makepkg --noconfirm -s

FROM docker.io/library/archlinux:base-devel AS final

ARG USERNAME=jsenecal
ARG UID=1000
ARG GID=1000
ENV USERNAME=${USERNAME}

RUN sed -i 's/^#Color/Color/' /etc/pacman.conf \
 && pacman -Syu --noconfirm \
      openssh git base-devel sudo fish curl wget unzip jq yq less \
      ripgrep fd bat eza htop rsync tmux nodejs npm github-cli \
      python python-pip ca-certificates tzdata inetutils ncurses \
      kubectl helm kustomize k9s kubectx stern sops age go-task \
      docker docker-compose docker-buildx \
 && pacman -Scc --noconfirm

# tmux/vim ship without the xterm-kitty terminfo entry, so SSH clients
# launched from kitty fail with "missing or unsuitable terminal: xterm-kitty".
RUN curl -fsSL https://raw.githubusercontent.com/kovidgoyal/kitty/master/terminfo/kitty.terminfo -o /tmp/kitty.terminfo \
 && tic -x -o /usr/share/terminfo /tmp/kitty.terminfo \
 && rm -f /tmp/kitty.terminfo

COPY --from=aur-build /home/builder/yay-bin/yay-bin-*.pkg.tar.zst /tmp/
RUN pacman -U --noconfirm /tmp/yay-bin-*.pkg.tar.zst \
 && rm -f /tmp/yay-bin-*.pkg.tar.zst

COPY rootfs/ /

RUN groupadd -g ${GID} ${USERNAME} \
 && useradd -l -m -u ${UID} -g ${GID} -G wheel -s /usr/bin/fish ${USERNAME} \
 && chmod 0440 /etc/sudoers.d/wheel-nopasswd \
 && chmod 0755 /usr/local/bin/code-pod-entrypoint.sh

RUN npm config --global set prefix /usr/local \
 && npm install -g @anthropic-ai/claude-code

USER ${USERNAME}
WORKDIR /home/${USERNAME}

RUN yay -S --noconfirm --answerdiff=None --answerclean=None \
        --mflags="--noconfirm --nocheck" \
        1password-cli kubecolor kubeconform-bin talosctl-bin \
        flux-bin cilium-cli helmfile mise

RUN curl -fsSL https://raw.githubusercontent.com/oh-my-fish/oh-my-fish/master/bin/install -o /tmp/omf-install \
 && fish /tmp/omf-install --noninteractive --yes \
 && rm -f /tmp/omf-install

RUN git clone --depth=1 https://github.com/gpakosz/.tmux.git \
 && ln -s -f .tmux/.tmux.conf .tmux.conf \
 && cp .tmux/.tmux.conf.local .

USER root
WORKDIR /

EXPOSE 22

LABEL org.opencontainers.image.source="https://github.com/jsenecal/vrtx-cluster" \
      org.opencontainers.image.title="code-pod" \
      org.opencontainers.image.description="Tailscale-attached Arch dev pod with Claude Code"

ENTRYPOINT ["/usr/local/bin/code-pod-entrypoint.sh"]
